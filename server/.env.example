# Copy to .env and fill in to use real OpenAI generation/analysis.
# Without this set, the server falls back to an offline MockAnatomyProvider
# (see src/lib/openai/mockProvider.ts) so the app still runs end-to-end.
OPENAI_API_KEY=

# Optional overrides:
# PORT=8787
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_TEXT_MODEL=gpt-4.1
